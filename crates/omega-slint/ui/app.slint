import { TopBar } from "topbar.slint";
import { PlayDock } from "dock.slint";
import {
    InstanceItem,
    ModItem,
    CapeItem,
    ServerItem,
    FriendItem,
    HomeScreenView,
    InstancesScreenView,
    ModrinthScreenView,
    StoreScreenView,
    AccountsScreenView,
    ServersScreenView,
    FriendsScreenView,
    ConsoleScreenView,
    SettingsScreenView
} from "screens.slint";

export component MainWindow inherits Window {
    title: "Omega Launcher";
    min-width: 1040px;
    min-height: 680px;
    preferred-width: 1120px;
    preferred-height: 720px;
    background: #07080e;

    in-out property <string> player-name: "Гость";
    in-out property <string> active-screen: "home";
    in-out property <string> active-instance-id: "inst_1";
    in-out property <string> active-instance-name: "test1";
    in-out property <string> active-version: "1.21.4";
    in-out property <string> active-loader: "Fabric";
    in-out property <string> active-playtime: "0 мин";
    in-out property <bool> is-game-running: false;
    in-out property <bool> is-sound-muted: false;
    in-out property <bool> is-profile-open: false;
    in-out property <string> log-content: "[launcher/INFO] Omega Launcher Native Slint Engine initialized.\n[launcher/INFO] SQLite database loaded from omega.db.\n[launcher/INFO] Ready to launch.";
    in-out property <int> ram-mb: 4096;
    in-out property <string> gc-type: "G1GC";
    in-out property <string> java-path: "/usr/bin/java (Java 21)";

    in-out property <[InstanceItem]> instances: [
        { id: "inst_1", name: "test1", mc-version: "1.21.4", loader: "Fabric", play-time: "0 мин", icon-name: "diamond_sword" },
        { id: "inst_2", name: "Survival 1.20", mc-version: "1.20.1", loader: "Forge", play-time: "140 мин", icon-name: "diamond_pickaxe" },
        { id: "inst_3", name: "Omega PvP Pack", mc-version: "1.21.4", loader: "NeoForge", play-time: "35 мин", icon-name: "netherite_sword" },
        { id: "inst_rust", name: "Minecraft Rust (Beta)", mc-version: "26.3", loader: "Rust", play-time: "0 мин", icon-name: "obsidian" }
    ];

    in-out property <[ModItem]> catalog-mods: [
        { id: "sodium", title: "Sodium", author: "jellysquid3", description: "Современный движок рендеринга, кардинально повышающий FPS.", downloads: "28.4M", loader: "Fabric" },
        { id: "iris", title: "Iris Shaders", author: "coderbot", description: "Шейдеры нового поколения с полной поддержкой Sodium.", downloads: "19.2M", loader: "Fabric" },
        { id: "lithium", title: "Lithium", author: "jellysquid3", description: "Оптимизация серверного тикрейта, физики мобов и генерации чанков.", downloads: "16.8M", loader: "Fabric" },
        { id: "fabric-api", title: "Fabric API", author: "modmuss50", description: "Базовая библиотека хуков и совместимости для модов Fabric.", downloads: "45.1M", loader: "Fabric" },
        { id: "jei", title: "Just Enough Items (JEI)", author: "mezz", description: "Просмотр рецептов крафта, плавки и предметов Minecraft.", downloads: "250.2M", loader: "Forge" }
    ];

    in-out property <[CapeItem]> capes: [
        { id: "migrator", name: "Migrator Cape", desc: "Официальный плащ за миграцию с Mojang на Microsoft", equipped: true },
        { id: "anniversary", name: "15th Anniversary", desc: "Юбилейный плащ в честь 15-летия Minecraft", equipped: false },
        { id: "vanilla", name: "Vanilla Cape", desc: "Эксклюзивный плащ для владельцев Java и Bedrock", equipped: false },
        { id: "cherry", name: "Cherry Blossom", desc: "Праздничный плащ цветущей вишни", equipped: false }
    ];

    in-out property <[ServerItem]> servers: [
        { name: "Omega Network Lobby", host: "play.omegamc.net:25565", ping: "18 ms", players: "142/500" },
        { name: "Hypixel Network", host: "mc.hypixel.net", ping: "42 ms", players: "45120/100000" },
        { name: "Local Survival Server", host: "127.0.0.1:25565", ping: "1 ms", players: "2/20" }
    ];

    in-out property <[FriendItem]> friends: [
        { name: "Alex_Gamer", online: true, status-text: "Играет на Omega Network" },
        { name: "Notch", online: false, status-text: "Был 2 часа назад" },
        { name: "Techno", online: false, status-text: "Не в сети" }
    ];

    callback play-clicked();
    callback select-instance(string, string);
    callback change-ram(int);
    callback change-gc(string);
    callback install-mod(string);
    callback equip-cape(string);
    callback login-microsoft();
    callback login-ely();
    callback create-offline-account();
    callback clear-logs();
    callback direct-connect(string);

    // Atmosphere Background (Landscape + Obsidian Gradient)
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("../assets/backgrounds/landscape_shader_mountains.png");
        image-fit: cover;
        opacity: 0.22;
    }

    // Main Viewport Layout
    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 16px;
        spacing: 12px;

        // Top Navigation Bar (Layer 2)
        TopBar {
            username: root.player-name;
            active-tab: root.active-screen;
            is-muted: root.is-sound-muted;
            is-dropdown-open: root.is-profile-open;

            tab-selected(tab) => {
                root.active-screen = tab;
            }
            toggle-profile-dropdown() => {
                root.is-profile-open = !root.is-profile-open;
            }
            toggle-sound() => {
                root.is-sound-muted = !root.is-sound-muted;
            }
        }

        // Center Screen Layer (Layer 4)
        Rectangle {
            vertical-stretch: 1;

            if root.active-screen == "home": HomeScreenView {
                open-store => { root.active-screen = "store"; }
                open-friends => { root.active-screen = "servers"; }
            }

            if root.active-screen == "instances": InstancesScreenView {
                instances: root.instances;
                active-instance-id: root.active-instance-id;
                select-instance(name, ver) => {
                    root.select-instance(name, ver);
                }
            }

            if root.active-screen == "modrinth": ModrinthScreenView {
                mods: root.catalog-mods;
                install-mod(id) => { root.install-mod(id); }
            }

            if root.active-screen == "store": StoreScreenView {
                capes: root.capes;
                equip-cape(id) => { root.equip-cape(id); }
            }

            if root.active-screen == "accounts": AccountsScreenView {
                active-account-name: root.player-name;
                login-microsoft => { root.login-microsoft(); }
                login-ely => { root.login-ely(); }
            }

            if root.active-screen == "servers": ServersScreenView {
                servers: root.servers;
                direct-connect(host) => { root.direct-connect(host); }
            }

            if root.active-screen == "friends": FriendsScreenView {
                friends: root.friends;
            }

            if root.active-screen == "console": ConsoleScreenView {
                log-content: root.log-content;
                clear-logs => { root.clear-logs(); }
            }

            if root.active-screen == "settings": SettingsScreenView {
                ram-mb: root.ram-mb;
                java-path: root.java-path;
                gc-type: root.gc-type;
                change-ram(ram) => { root.change-ram(ram); }
                change-gc(gc) => { root.change-gc(gc); }
            }
        }

        // Bottom Launch Dock (Layer 3)
        PlayDock {
            instance-name: root.active-instance-name;
            version-tag: root.active-version;
            loader-tag: root.active-loader;
            playtime-text: root.active-playtime;
            is-running: root.is-game-running;

            play-clicked => {
                root.play-clicked();
            }
            version-clicked => {
                root.active-screen = "instances";
            }
        }
    }
}
