export component NotchedCard inherits Rectangle {
    in property <color> card-background: #090c14;
    in property <color> card-border-color: #1e293b;
    in property <length> card-border-width: 2px;
    
    // Outer border shape (3 stepped rectangles)
    Rectangle {
        x: 6px;
        y: 0px;
        width: parent.width - 12px;
        height: parent.height;
        background: root.card-border-color;
    }
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        background: root.card-border-color;
    }
    Rectangle {
        x: 0px;
        y: 6px;
        width: parent.width;
        height: parent.height - 12px;
        background: root.card-border-color;
    }

    // Inner background fill
    Rectangle {
        x: 6px;
        y: root.card-border-width;
        width: parent.width - 12px;
        height: parent.height - 2 * root.card-border-width;
        background: root.card-background;
    }
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        background: root.card-background;
    }
    Rectangle {
        x: root.card-border-width;
        y: 6px;
        width: parent.width - 2 * root.card-border-width;
        height: parent.height - 12px;
        background: root.card-background;
    }

    @children
}

export component NotchedButton inherits Rectangle {
    in property <string> text: "КНОПКА";
    in property <color> btn-bg: #9f75ff;
    in property <color> btn-hover-bg: #b494ff;
    in property <color> btn-active-bg: #8c5ff8;
    in property <color> btn-text-color: #000000;
    in property <color> btn-border-color: #12131c;
    in property <length> font-size: 14px;
    in property <bool> is-running: false;
    
    callback clicked();

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    property <color> current-bg: touch.pressed ? root.btn-active-bg : (touch.has-hover ? root.btn-hover-bg : root.btn-bg);

    // Border
    Rectangle {
        x: 4px;
        y: 0px;
        width: parent.width - 8px;
        height: parent.height;
        background: root.btn-border-color;
    }
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        background: root.btn-border-color;
    }
    Rectangle {
        x: 0px;
        y: 4px;
        width: parent.width;
        height: parent.height - 8px;
        background: root.btn-border-color;
    }

    // Fill
    Rectangle {
        x: 4px;
        y: 2px;
        width: parent.width - 8px;
        height: parent.height - 4px;
        background: root.current-bg;
    }
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        background: root.current-bg;
    }
    Rectangle {
        x: 2px;
        y: 4px;
        width: parent.width - 4px;
        height: parent.height - 8px;
        background: root.current-bg;
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        
        Text {
            text: root.text;
            color: root.btn-text-color;
            font-size: root.font-size;
            font-weight: 800;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
