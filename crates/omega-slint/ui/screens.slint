import { ScrollView } from "std-widgets.slint";
import { ObsidianCard, ObsidianButton, ObsidianChip, ObsidianRow } from "components.slint";

export struct InstanceItem {
    id: string,
    name: string,
    mc-version: string,
    loader: string,
    play-time: string,
    icon-name: string,
}

export struct ModItem {
    id: string,
    title: string,
    author: string,
    description: string,
    downloads: string,
    loader: string,
}

export struct CapeItem {
    id: string,
    name: string,
    desc: string,
    equipped: bool,
}

export struct ServerItem {
    name: string,
    host: string,
    ping: string,
    players: string,
}

export struct FriendItem {
    name: string,
    online: bool,
    status-text: string,
}

export struct AccountItem {
    name: string,
    account-type: string,
    is-active: bool,
}

// Layer 4 Screen 0: Home Screen with 3D Character View (Center Stage)
export component HomeScreenView inherits Rectangle {
    in-out property <image> character-preview;
    callback open-store();
    callback open-friends();

    in-out property <float> screen-opacity: 1.0;
    in-out property <length> screen-offset-y: 0px;
    animate screen-opacity { duration: 200ms; easing: ease-out; }
    animate screen-offset-y { duration: 200ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    opacity: root.screen-opacity;
    y: root.screen-offset-y;

    VerticalLayout {
        alignment: end;
        padding-bottom: 6px;

        HorizontalLayout {
            alignment: center;

            Image {
                source: root.character-preview;
                width: 320px;
                height: 440px;
                image-fit: contain;
                horizontal-alignment: center;
                vertical-alignment: bottom;
            }
        }
    }
}

// Layer 4 Screen 1: Instances Screen
export component InstancesScreenView inherits Rectangle {
    in-out property <[InstanceItem]> instances;
    in-out property <string> active-instance-id: "";

    callback select-instance(string, string, string, string, string);
    callback create-instance();
    callback delete-instance(string);

    in-out property <float> screen-opacity: 1.0;
    in-out property <length> screen-offset-y: 0px;
    animate screen-opacity { duration: 200ms; easing: ease-out; }
    animate screen-offset-y { duration: 200ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    background: #0d1117;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    opacity: root.screen-opacity;
    y: root.screen-offset-y;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Header Row
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 3px;
                Text {
                    text: "Версии и сборки Minecraft";
                    color: #ffffff;
                    font-size: 19px;
                    font-weight: 800;
                }
                Text {
                    text: "Управление локальными экземплярами, версиями и модами";
                    color: #8b919c;
                    font-size: 13px;
                }
            }

            Rectangle {
                width: 156px;
                height: 40px;
                background: btn_touch.pressed ? #1e40af : (btn_touch.has-hover ? #2563eb : #1d5dc7);
                border-radius: 11px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.12);

                animate background { duration: 150ms; }

                btn_touch := TouchArea {
                    clicked => { root.create-instance(); }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: "+ Создать сборку";
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Instances List
        ScrollView {
            VerticalLayout {
                spacing: 10px;

                for inst in root.instances: Rectangle {
                    height: 70px;
                    background: inst.id == root.active-instance-id ? #22262e : (row_touch.has-hover ? #22262e : #1a1d24);
                    border-width: 1px;
                    border-color: inst.id == root.active-instance-id ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    row_touch := TouchArea {}

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: space-between;

                        // Left: Icon + Info
                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;

                            Rectangle {
                                width: 44px;
                                height: 44px;
                                background: #0d1117;
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.08);
                                border-radius: 8px;
                                y: (parent.height - self.height) / 2;

                                Image {
                                    source: @image-url("../assets/icons/diamond_sword.png");
                                    width: 28px;
                                    height: 28px;
                                    image-fit: contain;
                                    image-rendering: pixelated;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: inst.name;
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Версия: " + inst.mc-version;
                                        color: #e6e8ec;
                                        font-size: 12px;
                                    }
                                    Text {
                                        text: "• " + inst.loader;
                                        color: #10b981;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "• " + inst.play-time;
                                        color: #8b919c;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }

                        // Right: Actions
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;

                            // Delete button
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                y: (parent.height - self.height) / 2;
                                background: del_touch.pressed ? #9c3735 : (del_touch.has-hover ? #c44e4b : #1a1d24);
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.08);
                                border-radius: 9px;

                                del_touch := TouchArea {
                                    clicked => { root.delete-instance(inst.id); }
                                }

                                Text {
                                    text: "✕";
                                    color: #8b919c;
                                    font-size: 13px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Select / Play button
                            Rectangle {
                                width: 108px;
                                height: 38px;
                                y: (parent.height - self.height) / 2;
                                background: inst.id == root.active-instance-id ? #10b981 : (sel_touch.has-hover ? #2563eb : #1d5dc7);
                                border-radius: 9px;

                                animate background { duration: 150ms; }

                                sel_touch := TouchArea {
                                    clicked => {
                                        root.select-instance(inst.id, inst.name, inst.mc-version, inst.loader, inst.play-time);
                                    }
                                }

                                Text {
                                    text: inst.id == root.active-instance-id ? "Активна ✓" : "Выбрать";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Layer 4 Screen 2: Modrinth & CurseForge Catalog
export component ModrinthScreenView inherits Rectangle {
    in-out property <[ModItem]> mods;
    in-out property <string> active-category: "mods";

    callback search-query(string);
    callback install-mod(string);
    callback switch-category(string);

    in-out property <float> screen-opacity: 1.0;
    in-out property <length> screen-offset-y: 0px;
    animate screen-opacity { duration: 200ms; easing: ease-out; }
    animate screen-offset-y { duration: 200ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    background: #0d1117;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    opacity: root.screen-opacity;
    y: root.screen-offset-y;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Top Toolbar
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 3px;
                Text {
                    text: "Каталог Modrinth & CurseForge";
                    color: #ffffff;
                    font-size: 19px;
                    font-weight: 800;
                }
                Text {
                    text: "Прямая нативная загрузка проверенных модов, модпаков и шейдеров";
                    color: #8b919c;
                    font-size: 13px;
                }
            }

            // Category Filter Pills
            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Rectangle {
                    width: 80px;
                    height: 36px;
                    background: root.active-category == "mods" ? #1d5dc7 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.active-category == "mods" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.switch-category("mods"); } }
                    Text { text: "Моды"; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 90px;
                    height: 36px;
                    background: root.active-category == "shaders" ? #1d5dc7 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.active-category == "shaders" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.switch-category("shaders"); } }
                    Text { text: "Шейдеры"; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 90px;
                    height: 36px;
                    background: root.active-category == "modpacks" ? #1d5dc7 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.active-category == "modpacks" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.switch-category("modpacks"); } }
                    Text { text: "Сборки"; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // Search Input Bar
        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                height: 40px;
                horizontal-stretch: 1;
                background: #1a1d24;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                border-radius: 10px;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;

                    Text {
                        text: "🔍";
                        color: #8b919c;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    search_input := TextInput {
                        text: "";
                        font-size: 13px;
                        color: #ffffff;
                        vertical-alignment: center;
                        accepted => { root.search-query(self.text); }
                    }
                }
            }

            Rectangle {
                width: 90px;
                height: 40px;
                background: s_touch.pressed ? #1e40af : (s_touch.has-hover ? #2563eb : #1d5dc7);
                border-radius: 10px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.12);

                s_touch := TouchArea {
                    clicked => { root.search-query(search_input.text); }
                }

                Text {
                    text: "Найти";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Mods Grid / List
        ScrollView {
            VerticalLayout {
                spacing: 10px;

                for mod in root.mods: Rectangle {
                    height: 76px;
                    background: mod_touch.has-hover ? #22262e : #1a1d24;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    mod_touch := TouchArea {}

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: mod.title;
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "от " + mod.author;
                                    color: #8b919c;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    height: 18px;
                                    background: #1d5dc7;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text { text: mod.loader; color: #ffffff; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                    }
                                }
                            }

                            Text {
                                text: mod.description;
                                color: #8b919c;
                                font-size: 12px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            alignment: end;

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "⬇ " + mod.downloads;
                                    color: #10b981;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                            }

                            Rectangle {
                                width: 112px;
                                height: 38px;
                                y: (parent.height - self.height) / 2;
                                background: dl_touch.pressed ? #1e40af : (dl_touch.has-hover ? #2563eb : #1d5dc7);
                                border-radius: 9px;

                                dl_touch := TouchArea {
                                    clicked => { root.install-mod(mod.id); }
                                }

                                Text {
                                    text: "Установить";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Layer 4 Screen 3: Store Screen (Skins & Capes)
export component StoreScreenView inherits Rectangle {
    in-out property <[CapeItem]> capes;
    callback equip-cape(string);
    callback switch-skin(string);

    in-out property <float> screen-opacity: 1.0;
    in-out property <length> screen-offset-y: 0px;
    animate screen-opacity { duration: 200ms; easing: ease-out; }
    animate screen-offset-y { duration: 200ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    background: #0d1117;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    opacity: root.screen-opacity;
    y: root.screen-offset-y;

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        VerticalLayout {
            spacing: 3px;
            Text {
                text: "Магазин Omega (Скины и Официальные плащи)";
                color: #ffffff;
                font-size: 19px;
                font-weight: 800;
            }
            Text {
                text: "Синхронизация официальных скинов Mojang и плащей Minecraft";
                color: #8b919c;
                font-size: 13px;
            }
        }

        // Skins Quick Switch Row
        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                height: 44px;
                horizontal-stretch: 1;
                background: #1a1d24;
                border-radius: 10px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                TouchArea { clicked => { root.switch-skin("steve"); } }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text { text: "Скин Steve (Классика)"; color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                }
            }

            Rectangle {
                height: 44px;
                horizontal-stretch: 1;
                background: #1a1d24;
                border-radius: 10px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                TouchArea { clicked => { root.switch-skin("alex"); } }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text { text: "Скин Alex (Slim)"; color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                }
            }

            Rectangle {
                height: 44px;
                horizontal-stretch: 1;
                background: #1a1d24;
                border-radius: 10px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                TouchArea { clicked => { root.switch-skin("technoblade"); } }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text { text: "Скин Technoblade"; color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                }
            }
        }

        // Capes List
        ScrollView {
            VerticalLayout {
                spacing: 10px;

                for cape in root.capes: Rectangle {
                    height: 72px;
                    background: #1a1d24;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;

                            Rectangle {
                                width: 34px;
                                height: 46px;
                                background: #0d1117;
                                border-radius: 6px;
                                y: (parent.height - self.height) / 2;

                                Image {
                                    source: @image-url("../assets/capes/migrator.png");
                                    width: 30px;
                                    height: 42px;
                                    image-fit: contain;
                                    image-rendering: pixelated;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: cape.name;
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: cape.desc;
                                    color: #8b919c;
                                    font-size: 12px;
                                }
                            }
                        }

                        Rectangle {
                            width: 108px;
                            height: 38px;
                            y: (parent.height - self.height) / 2;
                            background: cape.equipped ? #10b981 : #1d5dc7;
                            border-radius: 9px;

                            TouchArea {
                                clicked => { root.equip-cape(cape.id); }
                            }

                            Text {
                                text: cape.equipped ? "Надет ✓" : "Надеть";
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Layer 4 Screen 4: Accounts Screen
export component AccountsScreenView inherits Rectangle {
    in-out property <string> active-account-name: "Гость";
    in-out property <string> account-type: "offline";
    in-out property <[AccountItem]> accounts;

    callback login-microsoft();
    callback login-ely();
    callback add-offline(string);
    callback delete-account(string);
    callback switch-account(string);

    in-out property <float> screen-opacity: 1.0;
    in-out property <length> screen-offset-y: 0px;
    animate screen-opacity { duration: 200ms; easing: ease-out; }
    animate screen-offset-y { duration: 200ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    background: #0d1117;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    opacity: root.screen-opacity;
    y: root.screen-offset-y;

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        VerticalLayout {
            spacing: 3px;
            Text {
                text: "Управление аккаунтами";
                color: #ffffff;
                font-size: 19px;
                font-weight: 800;
            }
            Text {
                text: "Подключение Microsoft, Ely.by и локальных оффлайн-профилей";
                color: #8b919c;
                font-size: 13px;
            }
        }

        // Active Account Card
        Rectangle {
            height: 84px;
            background: #1a1d24;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.22);
            border-radius: 12px;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    Rectangle {
                        width: 48px;
                        height: 48px;
                        background: #0d1117;
                        border-radius: 8px;
                        y: (parent.height - self.height) / 2;

                        Image {
                            source: @image-url("../assets/skins/steve.png");
                            width: 40px;
                            height: 40px;
                            image-fit: contain;
                            image-rendering: pixelated;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: root.active-account-name;
                            color: #ffffff;
                            font-size: 17px;
                            font-weight: 800;
                        }

                        Text {
                            text: "Тип: " + root.account-type + " • Активен";
                            color: #10b981;
                            font-size: 13px;
                            font-weight: 600;
                        }
                    }
                }
            }
        }

        // Add Offline Account Input
        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                height: 42px;
                horizontal-stretch: 1;
                background: #1a1d24;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                border-radius: 10px;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;

                    acc_input := TextInput {
                        text: "";
                        font-size: 13px;
                        color: #ffffff;
                        vertical-alignment: center;
                        accepted => {
                            if self.text != "" {
                                root.add-offline(self.text);
                                self.text = "";
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 160px;
                height: 42px;
                background: add_touch.pressed ? #1e40af : (add_touch.has-hover ? #2563eb : #1d5dc7);
                border-radius: 10px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.12);

                add_touch := TouchArea {
                    clicked => {
                        if acc_input.text != "" {
                            root.add-offline(acc_input.text);
                            acc_input.text = "";
                        }
                    }
                }

                Text {
                    text: "+ Добавить ник";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Auth Providers Row
        HorizontalLayout {
            spacing: 14px;

            // Microsoft OAuth Button
            Rectangle {
                height: 44px;
                horizontal-stretch: 1;
                background: ms_touch.has-hover ? #22262e : #1a1d24;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                border-radius: 11px;

                ms_touch := TouchArea {
                    clicked => { root.login-microsoft(); }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;

                    Image {
                        source: @image-url("../assets/svg/microsoft.svg");
                        width: 18px;
                        height: 18px;
                    }

                    Text {
                        text: "Войти через Microsoft";
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            // Ely.by Button
            Rectangle {
                height: 44px;
                horizontal-stretch: 1;
                background: ely_touch.has-hover ? #22262e : #1a1d24;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                border-radius: 11px;

                ely_touch := TouchArea {
                    clicked => { root.login-ely(); }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;

                    Text {
                        text: "Войти через Ely.by";
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Layer 4 Screen 5: Servers Screen (with live ping & quick play)
export component ServersScreenView inherits Rectangle {
    in-out property <[ServerItem]> servers;
    callback direct-connect(string);
    callback add-server(string, string);
    callback delete-server(string);

    in-out property <float> screen-opacity: 1.0;
    in-out property <length> screen-offset-y: 0px;
    animate screen-opacity { duration: 200ms; easing: ease-out; }
    animate screen-offset-y { duration: 200ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    background: #0d1117;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    opacity: root.screen-opacity;
    y: root.screen-offset-y;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        VerticalLayout {
            spacing: 3px;
            Text {
                text: "Серверы Minecraft";
                color: #ffffff;
                font-size: 19px;
                font-weight: 800;
            }
            Text {
                text: "Прямое подключение, статус онлайна и пинг в реальном времени";
                color: #8b919c;
                font-size: 13px;
            }
        }

        ScrollView {
            VerticalLayout {
                spacing: 10px;

                for srv in root.servers: Rectangle {
                    height: 70px;
                    background: srv_touch.has-hover ? #22262e : #1a1d24;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    srv_touch := TouchArea {}

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            Text {
                                text: srv.name;
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: srv.host;
                                    color: #8b919c;
                                    font-size: 12px;
                                }
                                Text {
                                    text: "• Игроки: " + srv.players;
                                    color: #10b981;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            alignment: end;

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "📶 " + srv.ping;
                                    color: #10b981;
                                    font-size: 13px;
                                    font-weight: 700;
                                }
                            }

                            Rectangle {
                                width: 126px;
                                height: 38px;
                                y: (parent.height - self.height) / 2;
                                background: play_touch.pressed ? #1e40af : (play_touch.has-hover ? #2563eb : #1d5dc7);
                                border-radius: 9px;

                                play_touch := TouchArea {
                                    clicked => { root.direct-connect(srv.host); }
                                }

                                Text {
                                    text: "Подключиться";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Layer 4 Screen 6: Friends Screen
export component FriendsScreenView inherits Rectangle {
    in-out property <[FriendItem]> friends;

    in-out property <float> screen-opacity: 1.0;
    in-out property <length> screen-offset-y: 0px;
    animate screen-opacity { duration: 200ms; easing: ease-out; }
    animate screen-offset-y { duration: 200ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    background: #0d1117;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    opacity: root.screen-opacity;
    y: root.screen-offset-y;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        VerticalLayout {
            spacing: 3px;
            Text {
                text: "Друзья Omega";
                color: #ffffff;
                font-size: 19px;
                font-weight: 800;
            }
            Text {
                text: "Список друзей и совместная игра по сети";
                color: #8b919c;
                font-size: 13px;
            }
        }

        ScrollView {
            VerticalLayout {
                spacing: 10px;

                for fr in root.friends: Rectangle {
                    height: 64px;
                    background: #1a1d24;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;

                            Rectangle {
                                width: 10px;
                                height: 10px;
                                background: fr.online ? #10b981 : #64748b;
                                border-radius: 5px;
                                y: (parent.height - self.height) / 2;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: fr.name;
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: fr.status-text;
                                    color: fr.online ? #10b981 : #8b919c;
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Layer 4 Screen 7: Console Screen (stdout / stderr stream)
export component ConsoleScreenView inherits Rectangle {
    in-out property <string> log-content: "";
    callback clear-logs();

    in-out property <float> screen-opacity: 1.0;
    in-out property <length> screen-offset-y: 0px;
    animate screen-opacity { duration: 200ms; easing: ease-out; }
    animate screen-offset-y { duration: 200ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    background: #0d1117;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    opacity: root.screen-opacity;
    y: root.screen-offset-y;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 3px;
                Text {
                    text: "Консоль логов игры";
                    color: #ffffff;
                    font-size: 19px;
                    font-weight: 800;
                }
                Text {
                    text: "Прямой нативный перехват stdout и stderr запущенного процесса Minecraft";
                    color: #10b981;
                    font-size: 13px;
                }
            }

            Rectangle {
                width: 100px;
                height: 36px;
                background: #1a1d24;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                border-radius: 9px;

                TouchArea {
                    clicked => { root.clear-logs(); }
                }

                Text {
                    text: "Очистить";
                    color: #8b919c;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: #06080d;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.08);
            border-radius: 10px;

            ScrollView {
                VerticalLayout {
                    padding: 14px;
                    Text {
                        text: root.log-content;
                        color: #10b981;
                        font-size: 12px;
                        font-family: "monospace";
                    }
                }
            }
        }
    }
}

// Layer 4 Screen 8: Settings Screen (RAM, GC, JRE)
export component SettingsScreenView inherits Rectangle {
    in-out property <int> ram-mb: 4096;
    in-out property <string> java-path: "/usr/bin/java (Java 21)";
    in-out property <string> gc-type: "G1GC";

    callback change-ram(int);
    callback change-gc(string);

    in-out property <float> screen-opacity: 1.0;
    in-out property <length> screen-offset-y: 0px;
    animate screen-opacity { duration: 200ms; easing: ease-out; }
    animate screen-offset-y { duration: 200ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    background: #0d1117;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    opacity: root.screen-opacity;
    y: root.screen-offset-y;

    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        alignment: start;

        VerticalLayout {
            spacing: 3px;
            Text {
                text: "Настройки лаунчера и JVM";
                color: #ffffff;
                font-size: 19px;
                font-weight: 800;
            }
            Text {
                text: "Параметры выделения памяти, сборщика мусора и Java рантайма";
                color: #8b919c;
                font-size: 13px;
            }
        }

        // RAM Allocation
        VerticalLayout {
            spacing: 10px;

            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: "Выделение оперативной памяти:";
                    color: #8b919c;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Text {
                    text: (root.ram-mb / 1024) + " ГБ (" + root.ram-mb + " МБ)";
                    color: #10b981;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 10px;

                Rectangle {
                    width: 90px;
                    height: 40px;
                    background: root.ram-mb == 2048 ? #10b981 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.ram-mb == 2048 ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.change-ram(2048); } }
                    Text { text: "2 ГБ"; color: root.ram-mb == 2048 ? #0d1117 : #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 90px;
                    height: 40px;
                    background: root.ram-mb == 4096 ? #10b981 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.ram-mb == 4096 ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.change-ram(4096); } }
                    Text { text: "4 ГБ"; color: root.ram-mb == 4096 ? #0d1117 : #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 90px;
                    height: 40px;
                    background: root.ram-mb == 6144 ? #10b981 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.ram-mb == 6144 ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.change-ram(6144); } }
                    Text { text: "6 ГБ"; color: root.ram-mb == 6144 ? #0d1117 : #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 90px;
                    height: 40px;
                    background: root.ram-mb == 8192 ? #10b981 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.ram-mb == 8192 ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.change-ram(8192); } }
                    Text { text: "8 ГБ"; color: root.ram-mb == 8192 ? #0d1117 : #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 90px;
                    height: 40px;
                    background: root.ram-mb == 12288 ? #10b981 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.ram-mb == 12288 ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.change-ram(12288); } }
                    Text { text: "12 ГБ"; color: root.ram-mb == 12288 ? #0d1117 : #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // Java Path
        VerticalLayout {
            spacing: 8px;
            Text {
                text: "Java Runtime Path:";
                color: #8b919c;
                font-size: 13px;
            }
            Rectangle {
                height: 42px;
                background: #1a1d24;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                border-radius: 10px;
                HorizontalLayout {
                    padding-left: 16px;
                    Text {
                        text: root.java-path;
                        color: #ffffff;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Garbage Collector Presets
        VerticalLayout {
            spacing: 8px;
            Text {
                text: "Сборщик мусора JVM (GC):";
                color: #8b919c;
                font-size: 13px;
            }
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 100px;
                    height: 38px;
                    background: root.gc-type == "G1GC" ? #1d5dc7 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.gc-type == "G1GC" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.change-gc("G1GC"); } }
                    Text { text: "G1GC"; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 100px;
                    height: 38px;
                    background: root.gc-type == "ZGC" ? #1d5dc7 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.gc-type == "ZGC" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.change-gc("ZGC"); } }
                    Text { text: "ZGC"; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 120px;
                    height: 38px;
                    background: root.gc-type == "Shenandoah" ? #1d5dc7 : #1a1d24;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: root.gc-type == "Shenandoah" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    TouchArea { clicked => { root.change-gc("Shenandoah"); } }
                    Text { text: "Shenandoah"; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
