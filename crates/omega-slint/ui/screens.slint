    }
}

export component ConsoleScreenView inherits Rectangle {
    in-out property <string> log-content: "";
    callback clear-logs();

    background: #0e121a;
    border-width: 1px;
    border-color: #262e40;
    border-radius: 14px;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "Консоль логов игры";
                    color: #ffffff;
                    font-size: 18px;
                    font-weight: 800;
                }
                Text {
                    text: "Прямой перехват stdout и stderr запущенного процесса";
                    color: #10b981;
                    font-size: 13px;
                }
            }

            Rectangle {
                width: 90px;
                height: 34px;
                background: #1e293b;
                border-radius: 6px;

                TouchArea {
                    clicked => { root.clear-logs(); }
                }

                Text {
                    text: "Очистить";
                    color: #94a3b8;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: #05060a;
            border-width: 1px;
            border-color: #1e293b;
            border-radius: 8px;

            ScrollView {
                VerticalLayout {
                    padding: 12px;
                    Text {
                        text: root.log-content;
                        color: #10b981;
                        font-size: 12px;
                        font-family: "JetBrains Mono, monospace";
                    }
                }
            }
        }
    }
}

export component SettingsScreenView inherits Rectangle {
    in-out property <int> ram-mb: 4096;
    in-out property <string> java-path: "/usr/bin/java (Java 21)";
    in-out property <string> gc-type: "G1GC";

    callback change-ram(int);
    callback change-gc(string);

    background: #0e121a;
    border-width: 1px;
    border-color: #262e40;
    border-radius: 14px;

    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        alignment: start;

        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Настройки лаунчера и JVM";
                color: #ffffff;
                font-size: 18px;
                font-weight: 800;
            }
            Text {
                text: "Параметры выделения памяти, сборщика мусора и Java рантайма";
                color: #94a3b8;
                font-size: 13px;
            }
        }

        // RAM Allocation
        VerticalLayout {
            spacing: 10px;

            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: "Выделение оперативной памяти:";
                    color: #94a3b8;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Text {
                    text: (root.ram-mb / 1024) + " ГБ (" + root.ram-mb + " МБ)";
                    color: #10b981;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 10px;

                Rectangle {
                    width: 90px;
                    height: 38px;
                    background: root.ram-mb == 2048 ? #10b981 : #111622;
                    border-radius: 6px;
                    TouchArea { clicked => { root.change-ram(2048); } }
                    Text { text: "2 ГБ"; color: root.ram-mb == 2048 ? #000000 : #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 90px;
                    height: 38px;
                    background: root.ram-mb == 4096 ? #10b981 : #111622;
                    border-radius: 6px;
                    TouchArea { clicked => { root.change-ram(4096); } }
                    Text { text: "4 ГБ"; color: root.ram-mb == 4096 ? #000000 : #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 90px;
                    height: 38px;
                    background: root.ram-mb == 6144 ? #10b981 : #111622;
                    border-radius: 6px;
                    TouchArea { clicked => { root.change-ram(6144); } }
                    Text { text: "6 ГБ"; color: root.ram-mb == 6144 ? #000000 : #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 90px;
                    height: 38px;
                    background: root.ram-mb == 8192 ? #10b981 : #111622;
                    border-radius: 6px;
                    TouchArea { clicked => { root.change-ram(8192); } }
                    Text { text: "8 ГБ"; color: root.ram-mb == 8192 ? #000000 : #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 90px;
                    height: 38px;
                    background: root.ram-mb == 12288 ? #10b981 : #111622;
                    border-radius: 6px;
                    TouchArea { clicked => { root.change-ram(12288); } }
                    Text { text: "12 ГБ"; color: root.ram-mb == 12288 ? #000000 : #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // Java Path
        VerticalLayout {
            spacing: 8px;
            Text {
                text: "Java Runtime Path:";
                color: #94a3b8;
                font-size: 13px;
            }
            Rectangle {
                height: 42px;
                background: #111622;
                border-width: 1px;
                border-color: #1e293b;
                border-radius: 6px;
                HorizontalLayout {
                    padding-left: 14px;
                    Text {
                        text: root.java-path;
                        color: #ffffff;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Garbage Collector
        VerticalLayout {
            spacing: 8px;
            Text {
                text: "Сборщик мусора JVM (GC):";
                color: #94a3b8;
                font-size: 13px;
            }
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 100px;
                    height: 36px;
                    background: root.gc-type == "G1GC" ? #1d5dc7 : #111622;
                    border-radius: 6px;
                    TouchArea { clicked => { root.change-gc("G1GC"); } }
                    Text { text: "G1GC"; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 100px;
                    height: 36px;
                    background: root.gc-type == "ZGC" ? #1d5dc7 : #111622;
                    border-radius: 6px;
                    TouchArea { clicked => { root.change-gc("ZGC"); } }
                    Text { text: "ZGC"; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 120px;
                    height: 36px;
                    background: root.gc-type == "Shenandoah" ? #1d5dc7 : #111622;
                    border-radius: 6px;
                    TouchArea { clicked => { root.change-gc("Shenandoah"); } }
                    Text { text: "Shenandoah"; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
