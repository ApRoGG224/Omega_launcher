export component TopBar inherits Rectangle {
    in-out property <string> username: "Гость";
    in-out property <string> active-tab: "home";
    in-out property <bool> is-dropdown-open: false;
    in-out property <bool> is-muted: false;

    callback tab-selected(string);
    callback toggle-profile-dropdown();
    callback login-microsoft();
    callback create-offline-account();
    callback toggle-sound();

    height: 52px;
    background: transparent;

    HorizontalLayout {
        alignment: center;

        // The Floating Top Dock
        Rectangle {
            height: 48px;
            background: #0e121a;
            border-width: 1px;
            border-color: #262e40;
            border-radius: 14px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                // 1. Profile Pill
                profile_btn := Rectangle {
                    height: 36px;
                    width: 130px;
                    background: root.is-dropdown-open ? #1a2232 : #111622;
                    border-width: 1px;
                    border-color: root.is-dropdown-open ? #38bdf8 : #1e293b;
                    border-radius: 10px;

                    TouchArea {
                        clicked => { root.toggle-profile-dropdown(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: root.username;
                            color: #f8fafc;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        // Avatar
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 4px;
                            background: #1e293b;

                            Image {
                                source: @image-url("../assets/skins/steve.png");
                                width: 22px;
                                height: 22px;
                                image-fit: contain;
                                image-rendering: pixelated;
                            }
                        }
                    }
                }

                // Divider
                Rectangle {
                    width: 1px;
                    height: 22px;
                    background: #1e293b;
                }

                // 2. Play / Home Button
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: root.active-tab == "home" ? #1d5dc7 : #111622;
                    border-width: 1px;
                    border-color: root.active-tab == "home" ? #3b82f6 : #1e293b;
                    border-radius: 9px;

                    TouchArea {
                        clicked => { root.tab-selected("home"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/home.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 3. Modrinth Catalog (Puzzle)
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: root.active-tab == "modrinth" ? #1d5dc7 : #111622;
                    border-width: 1px;
                    border-color: root.active-tab == "modrinth" ? #3b82f6 : #1e293b;
                    border-radius: 9px;

                    TouchArea {
                        clicked => { root.tab-selected("modrinth"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/puzzle.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 4. Instances / Versions (Package)
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: root.active-tab == "instances" ? #1d5dc7 : #111622;
                    border-width: 1px;
                    border-color: root.active-tab == "instances" ? #3b82f6 : #1e293b;
                    border-radius: 9px;

                    TouchArea {
                        clicked => { root.tab-selected("instances"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/package.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 5. Servers (Server)
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: root.active-tab == "servers" ? #1d5dc7 : #111622;
                    border-width: 1px;
                    border-color: root.active-tab == "servers" ? #3b82f6 : #1e293b;
                    border-radius: 9px;

                    TouchArea {
                        clicked => { root.tab-selected("servers"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/server.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 6. Omega Store (Shopping Bag)
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: root.active-tab == "store" ? #1d5dc7 : #111622;
                    border-width: 1px;
                    border-color: root.active-tab == "store" ? #3b82f6 : #1e293b;
                    border-radius: 9px;

                    TouchArea {
                        clicked => { root.tab-selected("store"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/store.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 7. Console (Terminal)
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: root.active-tab == "console" ? #1d5dc7 : #111622;
                    border-width: 1px;
                    border-color: root.active-tab == "console" ? #3b82f6 : #1e293b;
                    border-radius: 9px;

                    TouchArea {
                        clicked => { root.tab-selected("console"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/terminal.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 8. Friends (Users)
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: root.active-tab == "friends" ? #1d5dc7 : #111622;
                    border-width: 1px;
                    border-color: root.active-tab == "friends" ? #3b82f6 : #1e293b;
                    border-radius: 9px;

                    TouchArea {
                        clicked => { root.tab-selected("friends"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/users.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }

                    // Green online badge
                    Rectangle {
                        x: parent.width - 8px;
                        y: 4px;
                        width: 6px;
                        height: 6px;
                        background: #10b981;
                        border-radius: 3px;
                    }
                }

                // 9. Sound Mute
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: #111622;
                    border-width: 1px;
                    border-color: #1e293b;
                    border-radius: 9px;

                    TouchArea {
                        clicked => { root.toggle-sound(); }
                    }

                    Image {
                        source: @image-url("../assets/svg/volume.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                        opacity: root.is-muted ? 0.35 : 1.0;
                    }
                }

                // 10. Settings (Gear)
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: root.active-tab == "settings" ? #1d5dc7 : #111622;
                    border-width: 1px;
                    border-color: root.active-tab == "settings" ? #3b82f6 : #1e293b;
                    border-radius: 9px;

                    TouchArea {
                        clicked => { root.tab-selected("settings"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/settings.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }
            }
        }
    }
}
