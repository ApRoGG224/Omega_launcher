// Omega Launcher - Native HUD Top Bar (Layer 2)
// Strict compliance with PROMPT_NATIVE_MIGRATION.md:
// - Top Navigation Dock: border-radius: 16px, background: #0d1117, border: 1px solid rgba(255, 255, 255, 0.08)
// - Buttons: border-radius: 11px, background: #1a1d24 (Hover: #22262e, Active: #1d5dc7)

export component TopBar inherits Rectangle {
    in-out property <string> username: "Гость";
    in-out property <string> active-tab: "home";
    in-out property <bool> is-dropdown-open: false;
    in-out property <bool> is-muted: false;

    callback tab-selected(string);
    callback toggle-profile-dropdown();
    callback login-microsoft();
    callback login-ely();
    callback toggle-sound();

    height: 52px;
    background: transparent;

    HorizontalLayout {
        alignment: center;

        // The Floating Top Dock
        Rectangle {
            height: 48px;
            background: #0d1117;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.08);
            border-radius: 16px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                // 1. Profile Pill
                profile_btn := Rectangle {
                    height: 36px;
                    width: 130px;
                    background: root.is-dropdown-open ? #22262e : (prof_touch.has-hover ? #22262e : #1a1d24);
                    border-width: 1px;
                    border-color: root.is-dropdown-open ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    prof_touch := TouchArea {
                        clicked => { root.toggle-profile-dropdown(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: root.username;
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        // Avatar
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 6px;
                            background: #0d1117;

                            Image {
                                source: @image-url("../assets/skins/steve.png");
                                width: 22px;
                                height: 22px;
                                image-fit: contain;
                                image-rendering: pixelated;
                            }
                        }
                    }
                }

                // Divider
                Rectangle {
                    width: 1px;
                    height: 22px;
                    background: rgba(255, 255, 255, 0.08);
                }

                // 2. Play / Home Button
                Rectangle {
                    width: 38px;
                    height: 36px;
                    background: root.active-tab == "home" ? #1d5dc7 : (home_touch.has-hover ? #22262e : #1a1d24);
                    border-width: 1px;
                    border-color: root.active-tab == "home" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    home_touch := TouchArea {
                        clicked => { root.tab-selected("home"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/home.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 3. Modrinth Catalog (Puzzle)
                Rectangle {
                    width: 38px;
                    height: 36px;
                    background: root.active-tab == "modrinth" ? #1d5dc7 : (mod_touch.has-hover ? #22262e : #1a1d24);
                    border-width: 1px;
                    border-color: root.active-tab == "modrinth" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    mod_touch := TouchArea {
                        clicked => { root.tab-selected("modrinth"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/puzzle.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 4. Instances / Versions (Package)
                Rectangle {
                    width: 38px;
                    height: 36px;
                    background: root.active-tab == "instances" ? #1d5dc7 : (inst_touch.has-hover ? #22262e : #1a1d24);
                    border-width: 1px;
                    border-color: root.active-tab == "instances" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    inst_touch := TouchArea {
                        clicked => { root.tab-selected("instances"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/package.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 5. Servers (Server)
                Rectangle {
                    width: 38px;
                    height: 36px;
                    background: root.active-tab == "servers" ? #1d5dc7 : (srv_touch.has-hover ? #22262e : #1a1d24);
                    border-width: 1px;
                    border-color: root.active-tab == "servers" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    srv_touch := TouchArea {
                        clicked => { root.tab-selected("servers"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/server.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 6. Omega Store (Shopping Bag)
                Rectangle {
                    width: 38px;
                    height: 36px;
                    background: root.active-tab == "store" ? #1d5dc7 : (store_touch.has-hover ? #22262e : #1a1d24);
                    border-width: 1px;
                    border-color: root.active-tab == "store" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    store_touch := TouchArea {
                        clicked => { root.tab-selected("store"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/store.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 7. Console (Terminal)
                Rectangle {
                    width: 38px;
                    height: 36px;
                    background: root.active-tab == "console" ? #1d5dc7 : (con_touch.has-hover ? #22262e : #1a1d24);
                    border-width: 1px;
                    border-color: root.active-tab == "console" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    con_touch := TouchArea {
                        clicked => { root.tab-selected("console"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/terminal.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                // 8. Friends (Users)
                Rectangle {
                    width: 38px;
                    height: 36px;
                    background: root.active-tab == "friends" ? #1d5dc7 : (fr_touch.has-hover ? #22262e : #1a1d24);
                    border-width: 1px;
                    border-color: root.active-tab == "friends" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    fr_touch := TouchArea {
                        clicked => { root.tab-selected("friends"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/users.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }

                    // Green online badge
                    Rectangle {
                        x: parent.width - 8px;
                        y: 4px;
                        width: 6px;
                        height: 6px;
                        background: #10b981;
                        border-radius: 3px;
                    }
                }

                // 9. Sound Mute
                Rectangle {
                    width: 38px;
                    height: 36px;
                    background: mute_touch.has-hover ? #22262e : #1a1d24;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    mute_touch := TouchArea {
                        clicked => { root.toggle-sound(); }
                    }

                    Image {
                        source: @image-url("../assets/svg/volume.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                        opacity: root.is-muted ? 0.35 : 1.0;
                    }
                }

                // 10. Settings (Gear)
                Rectangle {
                    width: 38px;
                    height: 36px;
                    background: root.active-tab == "settings" ? #1d5dc7 : (set_touch.has-hover ? #22262e : #1a1d24);
                    border-width: 1px;
                    border-color: root.active-tab == "settings" ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.08);
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    set_touch := TouchArea {
                        clicked => { root.tab-selected("settings"); }
                    }

                    Image {
                        source: @image-url("../assets/svg/settings.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }
            }
        }
    }
}
