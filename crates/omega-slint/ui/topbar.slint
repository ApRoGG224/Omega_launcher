            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../assets/icons/minecraft/obsidian.png");
                width: 20px;
                height: 20px;
                image-fit: contain;
                image-rendering: pixelated;
            }

            HudTooltip {
                x: parent.width / 2;
                y: parent.height + 9px;
                text: "Minecraft Rust (Beta)";
                is-shown: sc1_touch.has-hover;
            }
        }

        // Shortcut 2: Diamond Sword (Cyan / Emerald - ACTIVE in Video)
        Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            background: root.active-shortcut == "diamond_sword" ? #14353c : (sc2_touch.has-hover ? #17373d : #10272b);
            border-width: root.active-shortcut == "diamond_sword" ? 1.5px : 1px;
            border-color: root.active-shortcut == "diamond_sword" ? #32dbcb : (sc2_touch.has-hover ? #67e8f9 : rgba(50, 219, 203, 0.50));
            border-radius: 8px;

            animate background { duration: 150ms; }
            animate border-color { duration: 150ms; }

            sc2_touch := TouchArea {
                clicked => {
                    root.active-shortcut = "diamond_sword";
                    root.select-shortcut("diamond_sword");
                }
            }

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../assets/icons/minecraft/diamond_sword.png");
                width: 20px;
                height: 20px;
                image-fit: contain;
                image-rendering: pixelated;
            }

            HudTooltip {
                x: parent.width / 2;
                y: parent.height + 9px;
                text: "Omega PvP Pack";
                is-shown: sc2_touch.has-hover;
            }
        }

        // Shortcut 3: End Crystal (Crystal Lavender / Gold)
        Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            background: root.active-shortcut == "end_crystal" ? #32183c : (sc3_touch.has-hover ? #32183c : #24102c);
            border-width: root.active-shortcut == "end_crystal" ? 1.5px : 1px;
            border-color: root.active-shortcut == "end_crystal" ? #e9d5ff : (sc3_touch.has-hover ? #e9d5ff : rgba(192, 132, 252, 0.50));
            border-radius: 8px;

