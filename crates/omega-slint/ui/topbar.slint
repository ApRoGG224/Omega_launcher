// Omega Launcher - Native HUD Top Bar (Layer 2)
// 1-to-1 Pixel-Accurate Replication of Production Top Dock
// - Center Floating HUD Dock: Height 48px, Radius 16px, Background #0e121a, Border rgba(255,255,255,0.08)
// - Profile Pill: [⌄  Username  [Avatar]] (38px, Radius 10px, Avatar 28x28px centered)
// - 7 Nav Buttons: Play (▶), Settings (⚙), Modrinth (🧩), Instances (📦), Servers (🗄️), Store (🛍️), Console (>_)
// - 4 Shortcuts: Obsidian, Diamond Sword, End Crystal, Netherite Sword (34x34px, Radius 8px)
// - Friends Button: Users icon with red badge "2" (38x38px)
// - Chevron Button: Right arrow ">" (38x38px)
// - Separate Flanks: GitHubButton & SoundButton (without frames, pure icons matching user request)
// - Tooltips on hover for every button

export component HudTooltip inherits Rectangle {
    in property <string> text;
    in property <bool> is-shown: false;

    width: 0px;
    height: 0px;

    tip_rect := Rectangle {
        x: -self.width / 2;
        y: 0px;
        width: tip_txt.preferred-width + 20px;
        height: 24px;
        background: #0e121a;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        opacity: root.is-shown ? 1.0 : 0.0;
        visible: root.is-shown;
        animate opacity { duration: 150ms; }

        Image {
            source: @image-url("../assets/svg/tooltip_arrow.svg");
            x: (parent.width - 10px) / 2;
            y: -4px;
            width: 10px;
            height: 5px;
        }

        tip_txt := Text {
            text: root.text;
            color: #f8fafc;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// Separate Left Flank: GitHub Icon (No border, transparent background, pure icon as in user photo)
export component GitHubButton inherits Rectangle {
    callback clicked();

    width: 38px;
    height: 38px;
    background: transparent;

    gh_touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("../assets/svg/github.svg");
        width: 22px;
        height: 22px;
        image-fit: contain;
        opacity: gh_touch.has-hover ? 1.0 : 0.80;
        animate opacity { duration: 150ms; }
    }

    HudTooltip {
        x: parent.width / 2;
        y: parent.height + 9px;
        text: "GitHub";
        is-shown: gh_touch.has-hover;
    }
}

// Separate Right Flank: Sound Mute Button (No border, transparent background, as in user photo)
export component SoundButton inherits Rectangle {
    in-out property <bool> is-muted: false;
    callback clicked();

    width: 38px;
    height: 38px;
    background: transparent;

    mute_touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("../assets/svg/volume.svg");
        width: 20px;
        height: 20px;
        image-fit: contain;
        opacity: root.is-muted ? 0.35 : (mute_touch.has-hover ? 1.0 : 0.80);
        animate opacity { duration: 150ms; }
    }

    HudTooltip {
        x: parent.width / 2;
        y: parent.height + 9px;
        text: root.is-muted ? "Включить звук" : "Отключить звук";
        is-shown: mute_touch.has-hover;
    }
}

// Center Floating HUD Top Dock (Compact Capsule - NOT full width)
export component TopBar inherits Rectangle {
    in-out property <string> username: "ApRoGG";
    in-out property <string> active-tab: "home";
    in-out property <string> active-shortcut: "diamond_sword";
    in-out property <bool> is-dropdown-open: false;

    callback tab-selected(string);
    callback toggle-profile-dropdown();
    callback select-shortcut(string);

    height: 48px;
    background: #0e121a;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 16px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 5px;
        alignment: center;

        // 1. Profile Pill: [⌄  Username  [Avatar]]
        profile_btn := Rectangle {
            height: 38px;
            background: prof_touch.pressed ? #22262e : (prof_touch.has-hover ? #1a2232 : #111622);
            border-width: 1px;
            border-color: root.is-dropdown-open ? rgba(255, 255, 255, 0.26) : (prof_touch.has-hover ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.10));
            border-radius: 10px;

            animate background { duration: 150ms; }
            animate border-color { duration: 150ms; }

            prof_touch := TouchArea {
                clicked => { root.toggle-profile-dropdown(); }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 8px;
                alignment: center;

                // Down Chevron ⌄
                Text {
                    text: "⌄";
                    color: prof_touch.has-hover ? #ffffff : #94a3b8;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                // Username
                Text {
                    text: root.username;
                    color: #f8fafc;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                // Crisp Square Avatar Frame (28x28) vertically centered in the 38px button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    background: #080d17;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.16);

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../assets/skins/aprogg_face.png");
                        width: 26px;
                        height: 26px;
                        image-fit: contain;
                        image-rendering: pixelated;
                    }
                }
            }

            HudTooltip {
                x: parent.width / 2;
                y: parent.height + 9px;
                text: "Аккаунты";
                is-shown: prof_touch.has-hover && !root.is-dropdown-open;
            }
        }

        // Divider 1 (mini divider)
        Rectangle {
            width: 1px;
            height: 16px;
            background: rgba(255, 255, 255, 0.08);
            y: (parent.height - self.height) / 2;
        }

        // 2. Play / Home Button (Solid White Triangle ▶)
        Rectangle {
            width: 38px;
            height: 38px;
            background: root.active-tab == "home" ? #1e2634 : (home_touch.has-hover ? #1a2232 : #111622);
            border-width: 1px;
            border-color: root.active-tab == "home" ? rgba(255, 255, 255, 0.26) : (home_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
            border-radius: 10px;

            animate background { duration: 150ms; }
            animate border-color { duration: 150ms; }

            home_touch := TouchArea {
                clicked => { root.tab-selected("home"); }
            }

            Text {
                text: "▶";
                color: #ffffff;
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            HudTooltip {
                x: parent.width / 2;
                y: parent.height + 9px;
                text: "ИГРАТЬ";
                is-shown: home_touch.has-hover;
            }
        }

        // 3. Settings (Gear ⚙)
        Rectangle {
            width: 38px;
            height: 38px;
            background: root.active-tab == "settings" ? #252f42 : (set_touch.has-hover ? #1a2232 : #111622);
            border-width: 1px;
            border-color: root.active-tab == "settings" ? rgba(255, 255, 255, 0.26) : (set_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
            border-radius: 10px;

            animate background { duration: 150ms; }
            animate border-color { duration: 150ms; }

            set_touch := TouchArea {
                clicked => { root.tab-selected("settings"); }
            }

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../assets/svg/settings.svg");
                width: 18px;
                height: 18px;
                image-fit: contain;
                opacity: root.active-tab == "settings" ? 1.0 : (set_touch.has-hover ? 1.0 : 0.75);
                animate opacity { duration: 150ms; }
            }

            HudTooltip {
                x: parent.width / 2;
                y: parent.height + 9px;
                text: "Настройки";
                is-shown: set_touch.has-hover;
            }
        }

        // 4. Modrinth Catalog (Puzzle 🧩)
        Rectangle {
            width: 38px;
            height: 38px;
            background: root.active-tab == "modrinth" ? #252f42 : (mod_touch.has-hover ? #1a2232 : #111622);
            border-width: 1px;
            border-color: root.active-tab == "modrinth" ? rgba(255, 255, 255, 0.26) : (mod_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
            border-radius: 10px;

            animate background { duration: 150ms; }
            animate border-color { duration: 150ms; }

            mod_touch := TouchArea {
                clicked => { root.tab-selected("modrinth"); }
            }

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../assets/svg/puzzle.svg");
                width: 18px;
                height: 18px;
                image-fit: contain;
                opacity: root.active-tab == "modrinth" ? 1.0 : (mod_touch.has-hover ? 1.0 : 0.75);
                animate opacity { duration: 150ms; }
            }

            HudTooltip {
                x: parent.width / 2;
                y: parent.height + 9px;
                text: "Каталог";
                is-shown: mod_touch.has-hover;
            }
        }

        // 5. Instances / Versions (Package 📦)
        Rectangle {
            width: 38px;
            height: 38px;
            background: root.active-tab == "instances" ? #252f42 : (inst_touch.has-hover ? #1a2232 : #111622);
            border-width: 1px;
            border-color: root.active-tab == "instances" ? rgba(255, 255, 255, 0.26) : (inst_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
            border-radius: 10px;

            animate background { duration: 150ms; }
            animate border-color { duration: 150ms; }

            inst_touch := TouchArea {
                clicked => { root.tab-selected("instances"); }
            }

            Image {
                x: (parent.width - self.width) / 2;
