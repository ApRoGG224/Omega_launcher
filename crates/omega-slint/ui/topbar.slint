                source: @image-url("../assets/svg/package.svg");
                width: 18px;
                height: 18px;
                image-fit: contain;
                opacity: root.active-tab == "instances" ? 1.0 : (inst_touch.has-hover ? 1.0 : 0.75);
                animate opacity { duration: 150ms; }
            }

            HudTooltip {
                x: parent.width / 2;
                y: parent.height + 9px;
                text: "Сборки";
                is-shown: inst_touch.has-hover;
            }
        }

        // 6. Servers (Server 🗄️)
        Rectangle {
            width: 38px;
