// Omega Launcher - Native HUD Top Bar (Layer 2)
// 1-to-1 Pixel-Accurate Replication of Production Top Dock (Photo 1)
// - Floating HUD Dock: Height 48px, Radius 16px, Background #0e121a, Border rgba(255,255,255,0.08)
// - Profile Pill: [⌄  Username  [Avatar]] (38px, Radius 10px, Avatar 28x28px)
// - 7 Nav Buttons: Play (▶), Settings (⚙), Modrinth (🧩), Instances (📦), Servers (🗄️), Store (🛍️), Console (>_)
// - 4 Shortcuts: Obsidian, Diamond Sword, End Crystal, Netherite Sword (34x34px, Radius 8px)
// - Friends Button: Users icon with red badge "2" (38x38px)
// - Chevron Button: Right arrow ">" (38x38px)

export component TopBar inherits Rectangle {
    in-out property <string> username: "ApRoGG";
    in-out property <string> active-tab: "home";
    in-out property <bool> is-dropdown-open: false;
    in-out property <bool> is-muted: false;

    callback tab-selected(string);
    callback toggle-profile-dropdown();
    callback select-shortcut(string);
    callback login-microsoft();
    callback login-ely();
    callback toggle-sound();
    callback open-github();

    height: 48px;
    background: transparent;

    // Left Flank: GitHub Icon (Transparent & Subtle, matching React hud-flank-left)
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 38px;
        height: 38px;
        background: gh_touch.pressed ? rgba(255, 255, 255, 0.12) : (gh_touch.has-hover ? rgba(255, 255, 255, 0.08) : transparent);
        border-width: 1px;
        border-color: gh_touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;
        border-radius: 10px;

        animate background { duration: 150ms; }
        animate border-color { duration: 150ms; }

        gh_touch := TouchArea {
            clicked => { root.open-github(); }
        }

        Image {
            source: @image-url("../assets/svg/github.svg");
            width: 20px;
            height: 20px;
            image-fit: contain;
            opacity: gh_touch.has-hover ? 1.0 : 0.70;
            animate opacity { duration: 150ms; }
        }
    }

    // Center: Floating HUD Top Dock (1-to-1 match with Photo 1)
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        height: 48px;
        background: #0e121a;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.08);
        border-radius: 16px;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 5px;
            alignment: center;

            // 1. Profile Pill: [⌄  Username  [Avatar]]
            profile_btn := Rectangle {
                height: 38px;
                background: prof_touch.pressed ? #22262e : (prof_touch.has-hover ? #1a2232 : #111622);
                border-width: 1px;
                border-color: root.is-dropdown-open ? rgba(255, 255, 255, 0.26) : (prof_touch.has-hover ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.10));
                border-radius: 10px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                prof_touch := TouchArea {
                    clicked => { root.toggle-profile-dropdown(); }
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 5px;
                    spacing: 8px;
                    alignment: center;

                    // Down Chevron ⌄
                    Text {
                        text: "⌄";
                        color: #94a3b8;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    // Username
                    Text {
                        text: root.username;
                        color: #f8fafc;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    // Crisp Square Avatar Frame (28x28) matching Photo 1
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        background: #080d17;
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.16);

                        Image {
                            source: @image-url("../assets/skins/aprogg_face.png");
                            width: 24px;
                            height: 24px;
                            image-fit: contain;
                            image-rendering: pixelated;
                        }
                    }
                }
            }

            // Divider 1
            Rectangle {
                width: 1px;
                height: 22px;
                background: rgba(255, 255, 255, 0.10);
                y: (parent.height - self.height) / 2;
            }

            // 2. Play / Home Button (Solid White Triangle ▶)
            Rectangle {
                width: 38px;
                height: 38px;
                background: root.active-tab == "home" ? #1e2634 : (home_touch.has-hover ? #1a2232 : #111622);
                border-width: 1px;
                border-color: root.active-tab == "home" ? rgba(255, 255, 255, 0.26) : (home_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
                border-radius: 10px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                home_touch := TouchArea {
                    clicked => { root.tab-selected("home"); }
                }

                Text {
                    text: "▶";
                    color: #ffffff;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 3. Settings (Gear ⚙)
            Rectangle {
                width: 38px;
                height: 38px;
                background: root.active-tab == "settings" ? #252f42 : (set_touch.has-hover ? #1a2232 : #111622);
                border-width: 1px;
                border-color: root.active-tab == "settings" ? rgba(255, 255, 255, 0.26) : (set_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
                border-radius: 10px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                set_touch := TouchArea {
                    clicked => { root.tab-selected("settings"); }
                }

                Image {
                    source: @image-url("../assets/svg/settings.svg");
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    opacity: root.active-tab == "settings" ? 1.0 : (set_touch.has-hover ? 1.0 : 0.75);
                    animate opacity { duration: 150ms; }
                }
            }

            // 4. Modrinth Catalog (Puzzle 🧩)
            Rectangle {
                width: 38px;
                height: 38px;
                background: root.active-tab == "modrinth" ? #252f42 : (mod_touch.has-hover ? #1a2232 : #111622);
                border-width: 1px;
                border-color: root.active-tab == "modrinth" ? rgba(255, 255, 255, 0.26) : (mod_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
                border-radius: 10px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                mod_touch := TouchArea {
                    clicked => { root.tab-selected("modrinth"); }
                }

                Image {
                    source: @image-url("../assets/svg/puzzle.svg");
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    opacity: root.active-tab == "modrinth" ? 1.0 : (mod_touch.has-hover ? 1.0 : 0.75);
                    animate opacity { duration: 150ms; }
                }
            }

            // 5. Instances / Versions (Package 📦)
            Rectangle {
                width: 38px;
                height: 38px;
                background: root.active-tab == "instances" ? #252f42 : (inst_touch.has-hover ? #1a2232 : #111622);
                border-width: 1px;
                border-color: root.active-tab == "instances" ? rgba(255, 255, 255, 0.26) : (inst_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
                border-radius: 10px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                inst_touch := TouchArea {
                    clicked => { root.tab-selected("instances"); }
                }

                Image {
                    source: @image-url("../assets/svg/package.svg");
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    opacity: root.active-tab == "instances" ? 1.0 : (inst_touch.has-hover ? 1.0 : 0.75);
                    animate opacity { duration: 150ms; }
                }
            }

            // 6. Servers (Server 🗄️)
            Rectangle {
                width: 38px;
                height: 38px;
                background: root.active-tab == "servers" ? #252f42 : (srv_touch.has-hover ? #1a2232 : #111622);
                border-width: 1px;
                border-color: root.active-tab == "servers" ? rgba(255, 255, 255, 0.26) : (srv_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
                border-radius: 10px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                srv_touch := TouchArea {
                    clicked => { root.tab-selected("servers"); }
                }

                Image {
                    source: @image-url("../assets/svg/server.svg");
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    opacity: root.active-tab == "servers" ? 1.0 : (srv_touch.has-hover ? 1.0 : 0.75);
                    animate opacity { duration: 150ms; }
                }
            }

            // 7. Omega Store (Shopping Bag 🛍️)
            Rectangle {
                width: 38px;
                height: 38px;
                background: root.active-tab == "store" ? #252f42 : (store_touch.has-hover ? #1a2232 : #111622);
                border-width: 1px;
                border-color: root.active-tab == "store" ? rgba(255, 255, 255, 0.26) : (store_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
                border-radius: 10px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                store_touch := TouchArea {
                    clicked => { root.tab-selected("store"); }
                }

                Image {
                    source: @image-url("../assets/svg/store.svg");
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    opacity: root.active-tab == "store" ? 1.0 : (store_touch.has-hover ? 1.0 : 0.75);
                    animate opacity { duration: 150ms; }
                }
            }

            // 8. Console (Terminal >_)
            Rectangle {
                width: 38px;
                height: 38px;
                background: root.active-tab == "console" ? #252f42 : (con_touch.has-hover ? #1a2232 : #111622);
                border-width: 1px;
                border-color: root.active-tab == "console" ? rgba(255, 255, 255, 0.26) : (con_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
                border-radius: 10px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                con_touch := TouchArea {
                    clicked => { root.tab-selected("console"); }
                }

                Text {
                    text: ">_";
                    color: root.active-tab == "console" ? #ffffff : (con_touch.has-hover ? #ffffff : #94a3b8);
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate color { duration: 150ms; }
                }
            }

            // Divider 2
            Rectangle {
                width: 1px;
                height: 22px;
                background: rgba(255, 255, 255, 0.10);
                y: (parent.height - self.height) / 2;
            }

            // 9. 4 Shortcut Badges (Photo 1: Obsidian, Diamond Sword, End Crystal, Netherite Sword)
            // Shortcut 1: Obsidian (Purple)
            Rectangle {
                width: 34px;
                height: 34px;
                y: (parent.height - self.height) / 2;
                background: sc1_touch.has-hover ? #251838 : #1b1228;
                border-width: 1px;
                border-color: sc1_touch.has-hover ? #c084fc : rgba(168, 85, 247, 0.50);
                border-radius: 8px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                sc1_touch := TouchArea {
                    clicked => { root.select-shortcut("obsidian"); }
                }

                Image {
                    source: @image-url("../assets/icons/minecraft/obsidian.png");
                    width: 20px;
                    height: 20px;
                    image-fit: contain;
                    image-rendering: pixelated;
                }
            }

            // Shortcut 2: Diamond Sword (Cyan)
            Rectangle {
                width: 34px;
                height: 34px;
                y: (parent.height - self.height) / 2;
                background: sc2_touch.has-hover ? #17373d : #10272b;
                border-width: 1px;
                border-color: sc2_touch.has-hover ? #67e8f9 : rgba(50, 219, 203, 0.50);
                border-radius: 8px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                sc2_touch := TouchArea {
                    clicked => { root.select-shortcut("diamond_sword"); }
                }

                Image {
                    source: @image-url("../assets/icons/minecraft/diamond_sword.png");
                    width: 20px;
                    height: 20px;
                    image-fit: contain;
                    image-rendering: pixelated;
                }
            }

            // Shortcut 3: End Crystal (Crystal Lavender / Gold)
            Rectangle {
                width: 34px;
                height: 34px;
                y: (parent.height - self.height) / 2;
                background: sc3_touch.has-hover ? #32183c : #24102c;
                border-width: 1px;
                border-color: sc3_touch.has-hover ? #e9d5ff : rgba(192, 132, 252, 0.50);
                border-radius: 8px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                sc3_touch := TouchArea {
                    clicked => { root.select-shortcut("end_crystal"); }
                }

                Image {
                    source: @image-url("../assets/icons/minecraft/end_crystal.png");
                    width: 20px;
                    height: 20px;
                    image-fit: contain;
                    image-rendering: pixelated;
                }
            }

            // Shortcut 4: Netherite Sword (Crimson / Ruby)
            Rectangle {
                width: 34px;
                height: 34px;
                y: (parent.height - self.height) / 2;
                background: sc4_touch.has-hover ? #301820 : #201216;
                border-width: 1px;
                border-color: sc4_touch.has-hover ? #fda4af : rgba(244, 63, 94, 0.45);
                border-radius: 8px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                sc4_touch := TouchArea {
                    clicked => { root.select-shortcut("netherite_sword"); }
                }

                Image {
                    source: @image-url("../assets/icons/minecraft/netherite_sword.png");
                    width: 20px;
                    height: 20px;
                    image-fit: contain;
                    image-rendering: pixelated;
                }
            }

            // Divider 3
            Rectangle {
                width: 1px;
                height: 22px;
                background: rgba(255, 255, 255, 0.10);
                y: (parent.height - self.height) / 2;
            }

            // 10. Friends (Users) with Red Notification Badge "2"
            Rectangle {
                width: 38px;
                height: 38px;
                background: root.active-tab == "friends" ? #252f42 : (fr_touch.has-hover ? #1a2232 : #111622);
                border-width: 1px;
                border-color: root.active-tab == "friends" ? rgba(255, 255, 255, 0.26) : (fr_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08));
                border-radius: 10px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                fr_touch := TouchArea {
                    clicked => { root.tab-selected("friends"); }
                }

                Image {
                    source: @image-url("../assets/svg/users.svg");
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    opacity: root.active-tab == "friends" ? 1.0 : (fr_touch.has-hover ? 1.0 : 0.75);
                    animate opacity { duration: 150ms; }
                }

                // Red Badge with count "2" matching Photo 1
                Rectangle {
                    x: parent.width - 13px;
                    y: 2px;
                    width: 15px;
                    height: 15px;
                    background: #ef4444;
                    border-width: 1px;
                    border-color: #7f1d1d;
                    border-radius: 7.5px;

                    Text {
                        text: "2";
                        color: #ffffff;
                        font-size: 8.5px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // 11. Right Chevron Button (38x38 matching Photo 1)
            Rectangle {
                width: 38px;
                height: 38px;
                background: chev_touch.pressed ? #22262e : (chev_touch.has-hover ? #1a2232 : #111622);
                border-width: 1px;
                border-color: chev_touch.has-hover ? rgba(255, 255, 255, 0.18) : rgba(255, 255, 255, 0.08);
                border-radius: 10px;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                chev_touch := TouchArea {
                    clicked => { root.tab-selected("settings"); }
                }

                Text {
                    text: ">";
                    color: chev_touch.has-hover ? #ffffff : #64748b;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate color { duration: 150ms; }
                }
            }
        }
    }

    // Right Flank: Audio Mute Button (Transparent & Subtle, matching React hud-flank-right)
    Rectangle {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: 38px;
        height: 38px;
        background: mute_touch.pressed ? rgba(255, 255, 255, 0.12) : (mute_touch.has-hover ? rgba(255, 255, 255, 0.08) : transparent);
        border-width: 1px;
        border-color: mute_touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;
        border-radius: 10px;

        animate background { duration: 150ms; }
        animate border-color { duration: 150ms; }

        mute_touch := TouchArea {
            clicked => { root.toggle-sound(); }
        }

        Image {
            source: @image-url("../assets/svg/volume.svg");
            width: 20px;
            height: 20px;
            image-fit: contain;
            opacity: root.is-muted ? 0.35 : (mute_touch.has-hover ? 1.0 : 0.70);
            animate opacity { duration: 150ms; }
        }
    }
}
