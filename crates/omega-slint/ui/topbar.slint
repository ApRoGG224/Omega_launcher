                y: parent.height + 9px;
                text: "test1";
                is-shown: sc3_touch.has-hover;
            }
        }

        // Shortcut 4: Netherite Sword (Crimson / Ruby)
        Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            background: root.active-shortcut == "netherite_sword" ? #301820 : (sc4_touch.has-hover ? #301820 : #201216);
            border-width: root.active-shortcut == "netherite_sword" ? 1.5px : 1px;
            border-color: root.active-shortcut == "netherite_sword" ? #fda4af : (sc4_touch.has-hover ? #fda4af : rgba(244, 63, 94, 0.45));
            border-radius: 8px;

