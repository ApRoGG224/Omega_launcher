        // Divider 2 (Divider before shortcuts)
        Rectangle {
            width: 1px;
            height: 22px;
            background: rgba(255, 255, 255, 0.10);
            y: (parent.height - self.height) / 2;
        }

        // 9. 4 Shortcut Badges
        // Shortcut 1: Obsidian (Purple)
        Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            background: root.active-shortcut == "obsidian" ? #2b1c40 : (sc1_touch.has-hover ? #251838 : #1b1228);
            border-width: root.active-shortcut == "obsidian" ? 1.5px : 1px;
            border-color: root.active-shortcut == "obsidian" ? #c084fc : (sc1_touch.has-hover ? #c084fc : rgba(168, 85, 247, 0.50));
            border-radius: 8px;

            animate background { duration: 150ms; }
            animate border-color { duration: 150ms; }

            sc1_touch := TouchArea {
                clicked => {
                    root.active-shortcut = "obsidian";
                    root.select-shortcut("obsidian");
