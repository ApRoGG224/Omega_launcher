// Omega Launcher - Native Bottom Play Dock (Layer 3)
// Geometry: border-radius: 14px, max-width: 580px, height: 64px
// Play button: height: 48px, border-radius: 11px, #e6e8ec (play) / #b3423f (stop)

export component PlayDock inherits Rectangle {
    in-out property <string> instance-name: "test1";
    in-out property <string> version-tag: "1.21.4";
    in-out property <string> loader-tag: "Fabric";
    in-out property <string> playtime-text: "0 мин";
    in-out property <bool> is-running: false;
    in-out property <string> launch-state: "idle"; // "idle" | "launching" | "running"
    in-out property <image> instance-icon: @image-url("../assets/icons/minecraft/netherite_sword.png");

    callback play-clicked();
    callback version-clicked();

    height: 72px;
    background: transparent;

    HorizontalLayout {
        alignment: center;

        // Floating Dock Container
        dock_container := Rectangle {
            height: 64px;
            width: 580px;
            background: #0d1117;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.08);
            border-radius: 14px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                // Left: Version / Instance Selector Block
                inst_btn := Rectangle {
                    height: 50px;
                    width: 360px;
                    y: (parent.height - self.height) / 2;
                    background: inst_touch.pressed ? #22262e : (inst_touch.has-hover ? #1a1d24 : transparent);
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: inst_touch.has-hover ? rgba(255, 255, 255, 0.12) : transparent;

                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    inst_touch := TouchArea {
                        clicked => { root.version-clicked(); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 12px;
                        alignment: start;

                        // 16x16 Pixel Icon Container
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            y: (parent.height - self.height) / 2;
                            background: #1a1d24;
                            border-width: 1px;
                            border-color: rgba(255, 255, 255, 0.08);
                            border-radius: 8px;

                            Image {
                                source: root.instance-icon;
                                width: 28px;
                                height: 28px;
                                image-fit: contain;
                                image-rendering: pixelated;
                            }
                        }

                        // Instance title and chips
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            Text {
                                text: root.instance-name;
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                // Loader Chip
                                Rectangle {
                                    height: 18px;
                                    background: #1a1d24;
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.08);
                                    border-radius: 6px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: root.loader-tag;
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Version Chip
                                Rectangle {
                                    height: 18px;
                                    background: #1a1d24;
                                    border-radius: 6px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: root.version-tag;
                                            color: #e6e8ec;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Playtime
                                Text {
                                    text: root.playtime-text;
                                    color: #8b919c;
                                    font-size: 11px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Right: Big Play / Launching / Stop Button
                play_btn := Rectangle {
                    height: 48px;
                    width: 160px;
                    y: (parent.height - self.height) / 2;
                    background: root.launch-state == "running"
                        ? (play_touch.pressed ? #9c3735 : (play_touch.has-hover ? #c44e4b : #b3423f))
                        : (root.launch-state == "launching"
                            ? (play_touch.pressed ? #1e40af : (play_touch.has-hover ? #2563eb : #1d5dc7))
                            : (play_touch.pressed ? #d5d8de : (play_touch.has-hover ? #f0f2f5 : #e6e8ec)));
                    border-radius: 11px;

                    animate background { duration: 150ms; }

                    play_touch := TouchArea {
                        clicked => { root.play-clicked(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        // Play/Stop/Wait Icon
                        Text {
                            text: root.launch-state == "running" ? "■" : (root.launch-state == "launching" ? "⏳" : "▶");
                            color: root.launch-state == "idle" ? #0d1117 : #ffffff;
                            font-size: 15px;
                            font-weight: 900;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.launch-state == "running" ? "СТОП" : (root.launch-state == "launching" ? "ЗАПУСК..." : "ИГРАТЬ");
                            color: root.launch-state == "idle" ? #0d1117 : #ffffff;
                            font-size: 15px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
