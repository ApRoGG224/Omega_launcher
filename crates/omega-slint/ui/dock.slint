// Omega Launcher - Native Bottom Play Dock (Layer 3)
// 1-to-1 Pixel-Accurate Replication of Production DockLayer from Reference Screenshot
// - Dock Container: height 88px, width 652px, background #0e1118, border 1px solid rgba(255, 255, 255, 0.08), radius 14px
// - Instance Icon: 64x64px, background #0a0c12, border rgba(255, 255, 255, 0.05), radius 12px, icon 36x36px pixelated
// - Instance Title: 19px font, weight 700, color #f2f4f8
// - Tags: Loader chip (22px, radius 6px, bg #20232a, border rgba(255,255,255,0.15)), Version chip (22px, radius 6px, bg #20232a, border rgba(255,255,255,0.15)), Playtime (12px, weight 600, color #7d8594)
// - Big Play Button: height 64px, width 315px, radius 14px, #c9ced8 background, #0e1118 text & play vector icon

export component PlayDock inherits Rectangle {
    in-out property <string> instance-name: "Моя версія 1.21";
    in-out property <string> version-tag: "26.3";
    in-out property <string> loader-tag: "FABRIC";
    in-out property <string> playtime-text: "0 мин";
    in-out property <bool> is-running: false;
    in-out property <string> launch-state: "idle"; // "idle" | "launching" | "running"
    in-out property <image> instance-icon: @image-url("../assets/icons/minecraft/netherite_sword.png");

    callback play-clicked();
    callback version-clicked();

    height: 88px;
    background: transparent;

    HorizontalLayout {
        alignment: center;

        // Floating Dock Card (600px x 88px matching reference screenshot exactly)
        dock_container := Rectangle {
            height: 88px;
            width: 600px;
            background: #0e1118;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.08);
            border-radius: 14px;

            HorizontalLayout {
                padding: 12px;
                spacing: 16px;
                alignment: space-between;

                // Left: Version / Instance Selector Block
                inst_btn := Rectangle {
                    horizontal-stretch: 1;
                    height: 64px;
                    y: (parent.height - self.height) / 2;
                    background: inst_touch.pressed ? #22262e : (inst_touch.has-hover ? rgba(255, 255, 255, 0.08) : transparent);
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: inst_touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    inst_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.version-clicked(); }
                    }

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;

                        // 64x64 Pixel Icon Container (with 36x36 pixelated icon)
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            y: (parent.height - self.height) / 2;
                            background: #0a0c12;
                            border-width: 1px;
                            border-color: rgba(255, 255, 255, 0.05);
                            border-radius: 12px;

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: root.instance-icon;
                                width: 36px;
                                height: 36px;
                                image-fit: contain;
                                image-rendering: pixelated;
                            }
                        }

                        // Instance title and chips
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;

                            Text {
                                text: root.instance-name;
                                color: #f2f4f8;
                                font-size: 19px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                // Loader Chip (e.g. FABRIC)
                                Rectangle {
                                    height: 22px;
                                    background: #20232a;
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.15);
                                    border-radius: 6px;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: root.loader-tag;
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            letter-spacing: 0.4px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Version Chip (e.g. 26.3 / 1.21.4)
                                Rectangle {
                                    height: 22px;
                                    background: #20232a;
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.15);
                                    border-radius: 6px;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: root.version-tag;
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Playtime
                                Text {
                                    text: root.playtime-text;
                                    color: #7d8594;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Right: Play / Launching / Stop Button (width 184px, height 64px)
                Rectangle {
                    width: 184px;
                    height: 64px;
                    y: (parent.height - self.height) / 2;

                    // Subtle ambient aura/halo around button
                    Rectangle {
                        x: -2px;
                        y: -2px;
                        width: parent.width + 4px;
                        height: parent.height + 4px;
                        border-radius: 16px;
                        background: root.launch-state == "running"
                            ? (play_touch.has-hover ? rgba(239, 68, 68, 0.35) : rgba(239, 68, 68, 0.15))
                            : (root.launch-state == "launching"
                                ? (play_touch.has-hover ? rgba(59, 130, 246, 0.40) : rgba(59, 130, 246, 0.18))
                                : (play_touch.has-hover ? rgba(255, 255, 255, 0.35) : rgba(255, 255, 255, 0.12)));
                        animate background { duration: 150ms; }
                    }

                    play_btn := Rectangle {
                        width: 100%;
                        height: 100%;
                        background: root.launch-state == "running"
                            ? (play_touch.pressed ? #9c3735 : (play_touch.has-hover ? #c44e4b : #b3423f))
                            : (root.launch-state == "launching"
                                ? (play_touch.pressed ? #1e40af : (play_touch.has-hover ? #2563eb : #1d5dc7))
                                : (play_touch.pressed ? #b8bdc8 : (play_touch.has-hover ? #ffffff : #d5dce6)));
                        border-width: 1.5px;
                        border-color: root.launch-state == "running"
                            ? (play_touch.has-hover ? #ef4444 : rgba(239, 68, 68, 0.6))
                            : (root.launch-state == "launching"
                                ? (play_touch.has-hover ? #60a5fa : rgba(59, 130, 246, 0.6))
                                : (play_touch.has-hover ? #ffffff : rgba(255, 255, 255, 0.55)));
                        border-radius: 14px;

                        animate background { duration: 150ms; }
                        animate border-color { duration: 150ms; }

                        play_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.play-clicked(); }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 12px;

                            // Icon vertically centered
                            VerticalLayout {
                                alignment: center;
                                width: 18px;

                                if root.launch-state == "idle": Image {
                                    source: @image-url("../assets/svg/play.svg");
                                    width: 18px;
                                    height: 18px;
                                    image-fit: contain;
                                    colorize: #0e1118;
                                }

                                if root.launch-state == "running": Text {
                                    text: "■";
                                    color: #ffffff;
                                    font-size: 18px;
                                    font-weight: 900;
                                    horizontal-alignment: center;
                                }

                                if root.launch-state == "launching": Text {
                                    text: "⏳";
                                    color: #ffffff;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                }
                            }

                            // Text vertically centered
                            VerticalLayout {
                                alignment: center;

                                Text {
                                    text: root.launch-state == "running" ? "СТОП" : (root.launch-state == "launching" ? "ЗАПУСК..." : "ИГРАТЬ");
                                    color: root.launch-state == "idle" ? #0e1118 : #ffffff;
                                    font-size: 18px;
                                    font-weight: 800;
                                    letter-spacing: 0.8px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
