export component PlayDock inherits Rectangle {
    in-out property <string> instance-name: "Minecraft Rust (Beta)";
    in-out property <string> version-tag: "1.20.1";
    in-out property <string> loader-tag: "Fabric";
    in-out property <string> playtime-text: "0 мин";
    in-out property <bool> is-running: false;
    in-out property <image> instance-icon: @image-url("../assets/icons/diamond_sword.png");

    callback play-clicked();
    callback version-clicked();

    height: 72px;
    background: transparent;

    HorizontalLayout {
        alignment: center;

        // Floating Dock Container
        dock_container := Rectangle {
            height: 64px;
            width: 580px;
            background: #0e121a;
            border-width: 1px;
            border-color: #262e40;
            border-radius: 14px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                // Left: Version / Instance Selector Block
                inst_btn := Rectangle {
                    height: 50px;
                    width: 360px;
                    y: (parent.height - self.height) / 2;
                    background: inst_touch.has-hover ? #161c28 : transparent;
                    border-radius: 10px;

                    inst_touch := TouchArea {
                        clicked => { root.version-clicked(); }
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        spacing: 12px;
                        alignment: start;

                        // 16x16 Pixel Icon Container
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            y: (parent.height - self.height) / 2;
                            background: #111622;
                            border-width: 1px;
                            border-color: #262e40;
                            border-radius: 8px;

                            Image {
                                source: root.instance-icon;
                                width: 28px;
                                height: 28px;
                                image-fit: contain;
                                image-rendering: pixelated;
                            }
                        }

                        // Instance title and chips
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            Text {
                                text: root.instance-name;
                                color: #f8fafc;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                // Loader Chip
                                Rectangle {
                                    height: 18px;
                                    background: #1d5dc7;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: root.loader-tag;
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Version Chip
                                Rectangle {
                                    height: 18px;
                                    background: #1e293b;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: root.version-tag;
                                            color: #94a3b8;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Playtime
                                Text {
                                    text: "• " + root.playtime-text;
                                    color: #64748b;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Right: Big Play / Stop Button
                play_btn := Rectangle {
                    height: 48px;
                    width: 160px;
                    y: (parent.height - self.height) / 2;
                    background: root.is-running
                        ? (play_touch.pressed ? #9c3735 : (play_touch.has-hover ? #c44e4b : #b3423f))
                        : (play_touch.pressed ? #8c5ff8 : (play_touch.has-hover ? #b494ff : #9f75ff));
                    border-radius: 10px;

                    play_touch := TouchArea {
                        clicked => { root.play-clicked(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        // Play/Stop Icon
                        Text {
                            text: root.is-running ? "■" : "▶";
                            color: root.is-running ? #ffffff : #000000;
                            font-size: 16px;
                            font-weight: 900;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.is-running ? "СТОП" : "ИГРАТЬ";
                            color: root.is-running ? #ffffff : #000000;
                            font-size: 15px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
